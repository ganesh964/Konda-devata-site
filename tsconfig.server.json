{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist-server",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-server"
  ]
}